{
  "name": "zepo-desk",
  "productName": "Zepo Desk",
  "private": true,
  "version": "1.3.0",
  "description": "Follow-ups, tareas y PoCs de Zepo en una app de escritorio.",
  "author": "Daniel San Martín",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c blue,magenta \"vite\" \"wait-on tcp:5173 && ZD_DEV=1 electron .\"",
    "dev:web": "concurrently -k -n vite,api -c blue,green \"vite\" \"ELECTRON_RUN_AS_NODE=1 electron server/standalone.js\"",
    "build": "tsc --noEmit && vite build",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --test 'test/*.test.js'",
    "seed": "ELECTRON_RUN_AS_NODE=1 electron scripts/seed-dev.js",
    "icons": "node scripts/make-icons.js",
    "postinstall": "electron-builder install-app-deps",
    "app:dev": "npm run build && electron .",
    "app:build": "npm run build && electron-builder --mac --arm64 --dir && npm run app:sign",
    "app:sign": "codesign --force --deep --sign - \"release/mac-arm64/Zepo Desk.app\"",
    "release": "bash scripts/release.sh",
    "app:install": "npm run app:build && osascript -e 'if application \"Zepo Desk\" is running then quit app \"Zepo Desk\"' && sleep 1 ; rm -rf \"/Applications/Zepo Desk.app\" && cp -a \"release/mac-arm64/Zepo Desk.app\" /Applications/"
  },
  "build": {
    "appId": "app.zepo.desk",
    "productName": "Zepo Desk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "server/**",
      "shared/**",
      "electron/**",
      "build/tray/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": false
      }
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.16"
  }
}
